# Copy to .env for local development. Never commit a real .env.
# PORT — local port (Render sets its own PORT automatically)
PORT=3000
# DATABASE_URL — Postgres connection string (Neon, Render, or local).
# Leave it empty to run with the in-memory store (local smoke tests only,
# data is lost on restart).
DATABASE_URL=
# TELEGRAM_BOT_TOKEN — the bot's token (BotFather). Required for Mini App
# auth verification AND for the /start welcome bot. Never share it.
TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_IDS — comma-separated numeric Telegram ids of the admins.
TELEGRAM_ADMIN_IDS=
# TELEGRAM_MINI_APP_URL — public address of the mini app, used for the
# "enter the exchange" button in the /start welcome message. Update it
# whenever the public address changes (new tunnel / stable domain).
TELEGRAM_MINI_APP_URL=https://obligations-devon-kills-patterns.trycloudflare.com/
